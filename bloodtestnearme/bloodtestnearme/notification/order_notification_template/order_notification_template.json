 "message": "<div style=\"max-width:650px;margin:0 auto;background:#ffffff;\nborder:1px solid #e5e7eb;border-radius:8px;\nfont-family:Arial,Helvetica,sans-serif;color:#111827;\">\n\n<!-- ================= HEADER ================= -->\n<div style=\"padding:16px;border-bottom:1px solid #e5e7eb;\">\n  <h2 style=\"margin:0 0 6px 0;font-size:18px;\">\n    Your Diagnostic Test Appointment is Confirmed\n  </h2>\n  <p style=\"margin:0;font-size:13px;\">\n    Dear {{ doc.customer_name }},\n  </p>\n  <p style=\"margin:6px 0 0 0;font-size:13px;line-height:1.5;\">\n    Thank you for scheduling your diagnostic test with us.\n    Your appointment has been successfully confirmed.\n    Please review the details below.\n  </p>\n</div>\n\n<!-- ================= BENEFICIARY DETAILS ================= -->\n<div style=\"padding:14px;\">\n  <div style=\"\n    border:1px solid #d3d3d3;\n    background:#f9fafb;\n    border-radius:6px;\n    padding:10px;\n  \">\n    <h3 style=\"margin:0 0 8px 0;font-size:15px;\">\n      Beneficiary Details\n    </h3>\n\n{% if doc.customer_details and doc.customer_details|length > 1 %}\n<table width=\"100%\" cellpadding=\"6\" cellspacing=\"0\">\n<tr>\n{% for row in doc.customer_details %}\n<td width=\"50%\" valign=\"top\">\n  <div style=\"\n    border:1px solid #e5e7eb;\n    background:#ffffff;\n    border-radius:6px;\n    padding:8px;\n  \">\n    <p style=\"margin:0;font-size:12px;line-height:1.4;\">\n      <b>Name:</b> {{ row.get(\"beneficiary_name\") or row.get(\"name1\") }}<br>\n      <b>Age:</b> {{ row.age }} Years<br>\n      <b>Gender:</b> {{ row.gender }}\n    </p>\n  </div>\n</td>\n{% if loop.index is even %}</tr><tr>{% endif %}\n{% endfor %}\n</tr>\n</table>\n\n<p style=\"margin:8px 0 0 0;font-size:12px;line-height:1.4;\">\n  <b>Phone:</b> {{ doc.mobile_number }}<br>\n  <b>Email:</b> {{ doc.email }}<br>\n  <b>Address:</b> {{ doc.address }}, {{ doc.pincode }}\n</p>\n\n{% else %}\n<p style=\"margin:0;font-size:12px;line-height:1.4;\">\n  <b>Name:</b> {{ doc.customer_name }}<br>\n  <b>Age:</b> {{ doc.age }} Years<br>\n  <b>Gender:</b> {{ doc.gender }}<br>\n  <b>Phone:</b> {{ doc.mobile_number }}<br>\n  <b>Email:</b> {{ doc.email }}<br>\n  <b>Address:</b> {{ doc.address }}, {{ doc.pincode }}\n</p>\n{% endif %}\n  </div>\n</div>\n\n<!-- ================= APPOINTMENT DETAILS ================= -->\n<div style=\"padding:14px;\">\n  <div style=\"\n    border:1px solid #d3d3d3;\n    background:#f9fafb;\n    border-radius:6px;\n    padding:10px;\n  \">\n    <h3 style=\"margin:0 0 8px 0;font-size:15px;\">\n      Appointment Details\n    </h3>\n\n    <ul style=\"margin:0;padding-left:14px;font-size:12px;line-height:1.5;\">\n      <li><b>Booking ID:</b> {{ doc.name }}</li>\n      <li><b>Date:</b> {{ frappe.format_date(doc.appointment_date) }}</li>\n      <li><b>Time:</b> {{ doc.appointment_time }}</li>\n      <li><b>Test / Package:</b>\n        {% for item in doc.ordered_items %}\n          {{ item.name1 }}{% if not loop.last %}, {% endif %}\n        {% endfor %}\n      </li>\n      <li><b>Amount:</b> \u20b9{{ doc.total_price }}</li>\n    </ul>\n  </div>\n</div>\n\n<!-- ================= PREPARATION INSTRUCTIONS ================= -->\n<div style=\"padding:14px;\">\n  <div style=\"\n    border:1px solid #d3d3d3;\n    background:#f9fafb;\n    border-radius:6px;\n    padding:10px;\n  \">\n    <h3 style=\"margin:0 0 8px 0;font-size:15px;\">\n      Preparation Instructions\n    </h3>\n\n    <ul style=\"margin:0;padding-left:14px;font-size:12px;line-height:1.5;\">\n      <li>Maintain 8\u201312 hours of fasting prior to sample collection.</li>\n      <li>Only plain water is permitted during the fasting period.</li>\n      <li>Avoid alcohol and heavy meals the night before your test.</li>\n      <li>Please ensure availability at the provided address during the scheduled time.</li>\n      <li>Reports will be shared digitally via WhatsApp after processing.</li>\n    </ul>\n  </div>\n</div>\n\n<!-- ================= FOOTER TEXT ================= -->\n<div style=\"padding:14px;font-size:12px;line-height:1.5;\">\n  <p style=\"margin:0;\">\n    If you need to reschedule or cancel your appointment,\n    please contact us at least <b>2 hours</b> in advance.\n  </p>\n  <p style=\"margin:6px 0 0 0;\">\n    Best regards,<br>\n    <b>Customer Support Team</b>\n  </p>\n</div>\n\n<!-- ================= FOOTER ================= -->\n<div style=\"background:#1e3a8a;padding:18px 12px;text-align:center;\nborder-radius:0 0 8px 8px;\">\n\n  <div style=\"margin-bottom:12px;\">\n    <a href=\"tel:+919611011266\"\n       style=\"background:#2563eb;color:#ffffff;text-decoration:none;\n       padding:8px 16px;border-radius:4px;font-size:12px;margin-right:6px;\">\n      Call Now\n    </a>\n    <a href=\"https://wa.me/919611011266\"\n       style=\"background:#22c55e;color:#ffffff;text-decoration:none;\n       padding:8px 16px;border-radius:4px;font-size:12px;\">\n      WhatsApp\n    </a>\n  </div>\n\n <div style=\"margin-bottom:14px;\">\n  <a href=\"https://www.facebook.com/BloodTestNearme/\" style=\"margin-right:10px;\">\n    <img src=\"https://cdn-icons-png.flaticon.com/24/733/733547.png\" width=\"20\">\n  </a>\n\n  <a href=\"https://www.instagram.com/bloodtestnearme/\" style=\"margin-right:10px;\">\n    <img src=\"https://cdn-icons-png.flaticon.com/24/733/733558.png\" width=\"20\">\n  </a>\n\n  <a href=\"https://x.com/BloodTestNearMe/\" style=\"margin-right:10px;\">\n    <img src=\"https://cdn-icons-png.flaticon.com/24/733/733579.png\" width=\"20\">\n  </a>\n\n  <a href=\"https://www.linkedin.com/company/blood-test-near-me/\">\n    <img src=\"https://cdn-icons-png.flaticon.com/24/733/733561.png\" width=\"20\">\n  </a>\n</div>\n\n\n  <div style=\"margin-bottom:8px;\">\n    <img src=\"{{ frappe.utils.get_url() }}/files/trigunalogo.png\"\n         style=\"max-width:160px;background:#ffffff;\n         padding:6px;border-radius:6px;\">\n  </div>\n\n  <p style=\"margin:4px 0;font-size:11px;color:#dbeafe;\">\n    \u00a9 {{ frappe.utils.nowdate()[:4] }} Triguna Healthcare. All rights reserved.\n  </p>\n\n  <p style=\"margin:0;font-size:11px;color:#c7d2fe;\">\n    Visit us:\n    <a href=\"https://www.trigunahealthcare.com\"\n       style=\"color:#ffffff;text-decoration:none;\">\n      www.trigunahealthcare.com\n    </a>\n  </p>\n\n  <p style=\"margin-top:6px;font-size:10px;color:#9ca3af;\">\n    You received this email because you booked our services.\n  </p>\n</div>\n\n</div>",
