 "html": "<style>\r\n    body {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 11px;\r\n        color: #000;\r\n        margin: 0;\r\n        padding: 0;\r\n    }\r\n\r\n    .wrapper {\r\n        width: 95%;\r\n        margin: auto;\r\n        padding: 15px;\r\n        border: 1px solid #999;\r\n    }\r\n\r\n    .header-logo img {\r\n        max-height: 55px;\r\n    }\r\n\r\n    .addr {\r\n        margin-top: 5px;\r\n        line-height: 1.35;\r\n        font-size: 10px;\r\n    }\r\n\r\n    .section-title {\r\n        background: #f7f7f7;\r\n        font-weight: bold;\r\n        padding: 6px 8px;\r\n        border: 1px solid #ccc;\r\n        margin-top: 15px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .summary-table td {\r\n        padding: 4px 2px;\r\n        font-size: 11px;\r\n        vertical-align: top;\r\n        line-height: 1.35;\r\n    }\r\n\r\n    .items-table, .items-table th, .items-table td {\r\n        border: 1px solid #bbb;\r\n        border-collapse: collapse;\r\n        padding: 6px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .items-table th {\r\n        background: #f7f7f7;\r\n        text-align: left;\r\n    }\r\n\r\n    .items-table td.price, .totals-box .totals-row span:last-child {\r\n        text-align: right;\r\n    }\r\n\r\n    .totals-box {\r\n        margin-top: 15px;\r\n        width: 35%;\r\n        float: right;\r\n        border: 1px solid #bbb;\r\n        padding: 10px;\r\n        font-size: 11px;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .totals-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        padding: 3px 0;\r\n    }\r\n\r\n    .note {\r\n        margin-top: 40px;\r\n        font-size: 10px;\r\n        text-align: center;\r\n        color: #555;\r\n    }\r\n\r\n    /* Ensure table cells align properly */\r\n    .items-table td, .items-table th {\r\n        vertical-align: middle;\r\n    }\r\n    .header-logo img {\r\n    image-rendering: auto;\r\n    -webkit-image-rendering: auto;\r\n    -webkit-transform: translateZ(0);\r\n}\r\n\r\n    \r\n</style>\r\n\r\n<div class=\"wrapper\">\r\n\r\n<!--  {% set lh = frappe.get_doc(\"Letter Head\", doc.letter_head) %}-->\r\n<!--{% if lh.image %}-->\r\n<!--    <div style=\"margin-bottom: 10px; text-align: left;\">-->\r\n<!--        <img src=\"{{ lh.image }}\" style=\"max-height: 80px;\">-->\r\n<!--    </div>-->\r\n<!--{% endif %}-->\r\n\r\n<div style=\"margin-bottom: 10px; text-align: left;\">\r\n    <img src=\"/files/trigunalogo.png\" style=\"max-height: 80px;\">\r\n</div>\r\n    <div class=\"addr\">\r\n        <b>Address 1:</b> Triguna Healthcare, Sy No, 373/3, Site No 5, Shop No 6, 10th Cross, Classic Paradise Layout, Begur Hulimavu Road, Begur, Bangalore, Karnataka 560068<br>\r\n        <b>Address 2:</b> Triguna Healthcare - 2, 12, Shop NO-2, Ground Floor, Arekere Main Road, Opp to Vels Global School, IIM Post, Bannerghatta Main Road, Bangalore, Karnataka 560076\r\n    </div>\r\n\r\n    <div class=\"section-title\">ORDER SUMMARY</div>\r\n\r\n    <table class=\"summary-table\" width=\"100%\">\r\n        <tr>\r\n            <td width=\"50%\">\r\n                <b>Name:</b> {{ doc.customer_name }}<br>\r\n                <b>Age:</b> {{ doc.age }}<br>\r\n                <b>Gender:</b> {{ doc.gender }}<br>\r\n                <!--{% if doc.order_type == \"Online\" %}-->\r\n                <b>Address:</b> {{ doc.address }}<br>\r\n                <!--{% endif %}-->\r\n                <b>Doctor:</b> {{ doc.doctor_name }}\r\n            </td>\r\n\r\n            <td width=\"50%\">\r\n                <b>Date:</b> {{ doc.appointment_date }}<br>\r\n                <b>Order No:</b> {{ doc.name }}<br>\r\n                \r\n                 <b>Source:</b> {{doc.source }}<br>\r\n                <!--<b>Appointment Time:</b> {{ doc.appointment_time }}<br>-->\r\n                <!--<b>No. of Persons:</b> {{ doc.number_of_persons }}<br>-->\r\n                <b>Payment Mode:</b> {{ doc.payment_mode }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <div class=\"section-title\" style=\"text-align:center\">TESTS</div>\r\n\r\n    <table class=\"items-table\" width=\"100%\">\r\n        <thead>\r\n            <tr>\r\n                <th width=\"10%\">Sl No</th>\r\n                <th width=\"60%\">Particulars</th>\r\n                <th width=\"20%\">Price (\u20b9)</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.ordered_items %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td>{{ item.name1 }}</td>\r\n                <td class=\"price\">{{ item.price }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <div class=\"totals-box\">\r\n        <div class=\"totals-row\">\r\n            <span><b>Total Item Price</b></span>\r\n            <span>\u20b9 {{ doc.total_item_price }}</span>\r\n        </div>\r\n        \r\n        <div class=\"totals-row\">\r\n            <span><b>Discount</b></span>\r\n            <span>\u20b9 {{ doc.discount }}</span>\r\n        </div>\r\n        \r\n        <div class=\"totals-row\">\r\n            <span><b>Total Price</b></span>\r\n            <span><b>\u20b9 {{ doc.total_price }}</b></span>\r\n        </div>\r\n    </div>\r\n<!-- After totals-box -->\r\n<div style=\"margin-top: 110px; width: 100%; font-size: 11px;\">\r\n\r\n    <hr style=\"border: 0; border-top: 1px solid #ccc; margin: 0;\">\r\n\r\n    <div style=\"text-align: right; margin-top: 5px;\">\r\n        \r\n        <b style=\"margin-right: 80px;\">Amount Paid:</b> <b style=\"margin-right: 10px;\">\u20b9 {{ doc.total_price }}</b>\r\n        \r\n    </div>\r\n\r\n    <div style=\"text-align: center; margin-top: 2px; font-size: 10px;\">\r\n        {% set amount_words = frappe.utils.money_in_words(doc.total_price) %}\r\n        <b>Amount in Words:</b> {{ amount_words }}\r\n    </div>\r\n\r\n    <hr style=\"border: 0; border-top: 1px solid #ccc; margin-top: 5px;\">\r\n</div>\r\n\r\n\r\n\r\n    <div style=\"clear: both;\"></div>\r\n    \r\n    \r\n\r\n    <div class=\"note\">\r\n        This is a computer-generated receipt and does not require a signature.\r\n    </div>\r\n    \r\n        <div class=\"phone\" style=\"margin-top: 50px;text-align: left;\">\r\n             <span><b>Phone : 9611011266</b></span>\r\n        </div>\r\n          <h1 style=\"text-align: right;\">Managing By</h1>\r\n<!--{% set lh = frappe.get_doc(\"Letter Head\", doc.letter_head) %}-->\r\n<!--{% if lh.image %}-->\r\n    <div style=\" text-align: right; margin-bottom: 50px;\">\r\n         <img src=\"/files/bloodtestnearmelogo.png\" style=\"max-height: 80px;\">\r\n    </div>\r\n<!--{% endif %}-->\r\n\r\n</div>\r\n",
