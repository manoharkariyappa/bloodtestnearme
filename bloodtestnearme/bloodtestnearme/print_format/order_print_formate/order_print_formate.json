 "font_size": 14,
 "html": "<style>\r\n    body {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 13px;\r\n        line-height: 1.55;  /* improved spacing */\r\n        color: #000;\r\n    }\r\n\r\n    .invoice-box {\r\n        width: 100%;\r\n        padding: 12px;\r\n        border: 1px solid #000;\r\n    }\r\n\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    table td, table th {\r\n        border: 1px solid #000;\r\n        padding: 6px;\r\n        font-size: 13px;\r\n    }\r\n\r\n    .no-border td {\r\n        border: none !important;\r\n        padding: 6px 2px;   /* added more spacing */\r\n    }\r\n\r\n    .section-title {\r\n        background: #f1f1f1;\r\n        font-weight: bold;\r\n        padding: 6px;\r\n        border: 1px solid #000;\r\n    }\r\n\r\n    .line-space {\r\n        margin-bottom: 6px; /* NEW: space between each line */\r\n    }\r\n</style>\r\n\r\n\r\n\r\n<div class=\"invoice-box\">\r\n\r\n    <!-- BUSINESS HEADER (similar to 2nd screenshot) -->\r\n   <div style=\"text-align: center; margin-bottom: 10px; line-height: 1.5;\">\r\n    <div style=\"font-size: 18px; font-weight: bold;\">\r\n        YOUR BUSINESS NAME\r\n    </div>\r\n\r\n    <div>\r\n        Address line 1, Address line 2, City - Pincode\r\n    </div>\r\n\r\n    <div>\r\n        Mobile: 9876543210 | Email: info@yourbusiness.com\r\n    </div>\r\n</div>\r\n\r\n\r\n   <div class=\"section-title\">ORDER SUMMARY</div>\r\n\r\n<table class=\"no-border\">\r\n    <tr>\r\n        <!-- LEFT SIDE -->\r\n        <td style=\"width: 50%; vertical-align: top;\">\r\n            <div class=\"line-space\"><b>Customer Name:</b> {{ doc.customer_name }}</div>\r\n            <div class=\"line-space\"><b>Age:</b> {{ doc.age }}</div>\r\n            <div class=\"line-space\"><b>Email:</b> {{ doc.email }}</div>\r\n            <div class=\"line-space\"><b>Mobile:</b> {{ doc.mobile_number }}</div>\r\n\r\n            <div class=\"line-space\"><b>Address:</b> {{ doc.address }}</div>\r\n            <div class=\"line-space\"><b>Gender:</b> {{ doc.gender }}</div>\r\n            <div class=\"line-space\"><b>Pincode:</b> {{ doc.pincode }}</div>\r\n            <div class=\"line-space\"><b>Doctor:</b> {{ doc.doctor_name }}</div>\r\n        </td>\r\n\r\n        <!-- RIGHT SIDE -->\r\n        <td style=\"width: 50%; vertical-align: top;\">\r\n            <div class=\"line-space\"><b>Order No:</b> {{ doc.name }}</div>\r\n            <div class=\"line-space\"><b>Appointment Date:</b> {{ doc.appointment_date }}</div>\r\n            <div class=\"line-space\"><b>Appointment Time:</b> {{ doc.appointment_time }}</div>\r\n            <div class=\"line-space\"><b>Number of Persons:</b> {{ doc.number_of_persons }}</div>\r\n\r\n            <!--<div class=\"line-space\"><b>Created Date:</b> {{ doc.created_date }}</div>-->\r\n            <!--<div class=\"line-space\"><b>Updated Date:</b> {{ doc.updated_date }}</div>-->\r\n            <div class=\"line-space\"><b>Status:</b> {{ doc.status }}</div>\r\n            <div class=\"line-space\"><b>Order Type:</b> {{ doc.order_type }}</div>\r\n            <!-- NEW FIELDS YOU WANT IN SUMMARY -->\r\n            <div class=\"line-space\"><b>Hard Copy Required:</b> {% if doc.hard_copy_required %}\u2714{% else %}\u2718{% endif %}</div>\r\n            <div class=\"line-space\"><b>Affiliated ID:</b> {{ doc.affiliated_id }}</div>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n    <!-- CUSTOMER DETAILS TABLE -->\r\n    <div class=\"section-title\">CUSTOMER DETAILS</div>\r\n\r\n    <table>\r\n        <thead>\r\n            <tr>\r\n                <th>Sl No</th>\r\n                <th>Name</th>\r\n                <th>Age</th>\r\n                <th>Gender</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for row in doc.customer_details %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td>{{ row.name1 }}</td>\r\n                <td>{{ row.age }}</td>\r\n                <td>{{ row.gender }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ORDER ITEMS TABLE -->\r\n    <div class=\"section-title\">ORDERED ITEMS</div>\r\n\r\n    <table>\r\n        <thead>\r\n            <tr>\r\n                <th>Sl No</th>\r\n                <th>Test / Item Name</th>\r\n                <th>Price (\u20b9)</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.ordered_items %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td>{{ item.name1 }}</td>\r\n                <td>{{ item.price }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- TOTALS -->\r\n    <table style=\"margin-top: 10px;\">\r\n        <tr>\r\n            <td style=\"width: 60%; border: none;\"></td>\r\n            <td style=\"width: 40%;\">\r\n                <table>\r\n                    <tr>\r\n                        <td><b>Total Item Price</b></td>\r\n                        <td>\u20b9 {{ doc.total_item_price }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td><b>Total Price</b></td>\r\n                        <td>\u20b9 {{ doc.total_price }}</td>\r\n                    </tr>\r\n                   \r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n</div>\r\n",
