 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div class=\\\"print-heading\\\">\\t\\t\\t\\t<h2><div>QR Demo</div><br><small class=\\\"sub-heading\\\">{{ doc.name }}</small>\\t\\t\\t\\t</h2></div>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"title\", \"print_hide\": 0, \"label\": \"Title\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<img src=\\\"{{ doc.qr_code }}\\\" alt=\\\"{{ doc.title }}\\\"/>\"}, {\"fieldname\": \"qr_image\", \"print_hide\": 0, \"label\": \"QR Image\"}]",
 "html": "<div style=\"width: 400px; height: 550px; border: 2px solid #000; border-radius: 10px; text-align: center; padding: 20px; margin: auto; font-family: Arial, sans-serif;\">\n  \n  <!-- Logo -->\n  <img src=\"/files/bloodtestnearmelogo.png\" alt=\"Triguna Logo\" style=\"width: 200px; margin-bottom: 10px;\" />\n\n  <!-- Title -->\n  <h1 style=\"font-size: 24px; margin: 10px 0; color: #333;\">Triguna QR Code</h1>\n  <p style=\"font-size: 18px; color: #555;\">Scan here<br> For Health Checkup </p>\n\n  <!-- QR Code -->\n  <div style=\"margin: 20px 0;\">\n    <img src=\"{{ doc.qr_code }}\" alt=\"{{ doc.title }}\" style=\"width: 250px; height: 250px;\" />\n  </div>\n\n  <!-- Scan Text -->\n\n  <!-- Optional Footer (like PhonePe sheet) -->\n  <p style=\"font-size: 14px; color: #777; margin-top: 40px;\">Powered by Triguna Health Care</p>\n\n</div>\n\n\n\n<!--<p>QR Code generated ad-hoc:</p>-->\n<!--<img src=\"{{ get_qr_code('Hello World!') }}\" alt=\"Hello World!\"/>-->",
