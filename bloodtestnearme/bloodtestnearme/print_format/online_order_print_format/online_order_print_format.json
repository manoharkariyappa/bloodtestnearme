 "html": "<style>\r\n@page {\r\n    margin: 12mm;\r\n}\r\n\r\nbody {\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 11px;\r\n    color: #222;\r\n    margin: 0;\r\n}\r\n\r\n.wrapper {\r\n    border: 1px solid #bbb;\r\n    padding: 14px;\r\n}\r\n\r\n.header {\r\n    display: table;\r\n    width: 100%;\r\n    border-bottom: 1px solid #ccc;\r\n    padding-bottom: 6px;\r\n}\r\n\r\n.header-left,\r\n.header-right {\r\n    display: table-cell;\r\n    vertical-align: top;\r\n}\r\n\r\n.header-left {\r\n    width: 130px;\r\n}\r\n\r\n.header-left img {\r\n    max-height: 100px;   /* IMPORTANT */\r\n    display: block;\r\n}\r\n\r\n.header-right {\r\n    padding-left: 8px;\r\n}\r\n\r\n.address-block {\r\n    font-size: 10px;\r\n    line-height: 1.4;\r\n    text-align: left;\r\n}\r\n\r\n\r\n/* SECTION TITLE */\r\n.section-title {\r\n    margin-top: 14px;\r\n    padding: 6px;\r\n    font-weight: bold;\r\n    border: 1px solid #ccc;\r\n    background: #f5f6f7;\r\n}\r\n\r\n/* SUMMARY TABLE */\r\n.summary-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 6px;\r\n}\r\n\r\n/*.summary-table td {*/\r\n/*    width: 50%;*/\r\n/*    vertical-align: top;*/\r\n/*    padding: 6px;*/\r\n/*}*/\r\n.summary-table td {\r\n    width: 50%;\r\n    vertical-align: top;\r\n    padding: 0px !important;\r\n}\r\n\r\n\r\n.summary-block div {\r\n    margin-bottom: 4px;\r\n}\r\n\r\n/* TEST TABLE */\r\n.items-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 8px;\r\n}\r\n\r\n.items-table th,\r\n.items-table td {\r\n    border: 1px solid #ccc;\r\n    padding: 6px;\r\n}\r\n\r\n.items-table th {\r\n    background: #f5f6f7;\r\n    text-align: left;\r\n}\r\n\r\n.amount {\r\n    text-align: right;\r\n}\r\n\r\n/* TOTALS */\r\n.totals {\r\n    width: 40%;\r\n    margin-left: auto;\r\n    margin-top: 10px;\r\n    border: 1px solid #ccc;\r\n    padding: 6px;\r\n}\r\n\r\n.totals-row {\r\n    display: table;\r\n    width: 100%;\r\n    margin-bottom: 4px;\r\n}\r\n\r\n.totals-row span {\r\n    display: table-cell;\r\n}\r\n\r\n.totals-row span:last-child {\r\n    text-align: right;\r\n    font-weight: bold;\r\n}\r\n\r\n/* FOOTER */\r\n.footer {\r\n    margin-top: 16px;\r\n    border-top: 1px solid #ccc;\r\n    padding-top: 6px;\r\n    font-size: 10px;\r\n}\r\n\r\n.footer-bottom {\r\n    display: table;\r\n    width: 100%;\r\n    margin-top: 20px;\r\n}\r\n\r\n.footer-left,\r\n.footer-right {\r\n    display: table-cell;\r\n    vertical-align: bottom;\r\n}\r\n\r\n.footer-right {\r\n    text-align: right;\r\n}\r\n</style>\r\n{% set hardcopy_charge = 75.0 if doc.hard_copy_required else 0 %}\r\n{% set total_discount = (doc.discount or 0) + (doc.extra_discount or 0) %}\r\n\r\n\r\n<div class=\"wrapper\">\r\n\r\n<!-- HEADER -->\r\n<!-- HEADER -->\r\n<div class=\"header\">\r\n    <div class=\"header-left\">\r\n        <img src=\"/files/Thyrocarelogo.jpg\">\r\n    </div>\r\n\r\n    <div class=\"header-right\">\r\n        <div class=\"address-block\">\r\n            <div>\r\n                <b>Address 1:</b> Triguna Healthcare, Sy No 373/3, Site No 5, Shop No 6,\r\n                10th Cross, Classic Paradise Layout, Begur Hulimavu Road,\r\n                Begur, Bangalore, Karnataka 560068<br>\r\n                <b>Phone:</b> 9611011266\r\n            </div>\r\n\r\n            <div style=\"margin-top:4px;\">\r\n                <b>Address 2:</b> Triguna Healthcare \u2013 2, 12, Shop No-2, Ground Floor,\r\n                Arekere Main Road, Opp to Vels Global School, IIM Post,\r\n                Bannerghatta Main Road, Bangalore, Karnataka 560076<br>\r\n                <b>Phone:</b> 9606621146\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n\r\n<!--</div>-->\r\n\r\n<!-- ORDER SUMMARY -->\r\n<div class=\"section-title\">RECIEPT</div>\r\n\r\n<table class=\"summary-table\">\r\n<tr>\r\n<td>\r\n    <div class=\"summary-block\">\r\n        <div><b>Name:</b> {{ doc.customer_name }}</div>\r\n        <div><b>Age:</b> {{ doc.age }}</div>\r\n        <div><b>Gender:</b> {{ doc.gender }}</div>\r\n        <div><b>Mobile No:</b> {{ doc.mobile_number }}</div>\r\n        <div><b>Ref Dr:</b> {{ doc.doctor_name }}</div>\r\n        <!--<div><b>Address:</b> {{ doc.address }}</div>-->\r\n    </div>\r\n</td>\r\n<td>\r\n    <div class=\"summary-block\">\r\n        <div><b>Date:</b> {{ doc.appointment_date }}</div>\r\n        <div><b>Order No:</b> {{ doc.name }}</div>\r\n        <div><b>Source:</b> {{ doc.source }}</div>\r\n        <div><b>Payment Mode:</b> {{ doc.payment_mode }}</div>\r\n    </div>\r\n</td>\r\n</tr>\r\n</table>\r\n<div><b>Address:</b> {{ doc.address }}</div>\r\n\r\n\r\n<!-- TEST DETAILS -->\r\n<div class=\"section-title\" style=\"text-align:center;\">TEST DETAILS</div>\r\n\r\n<table class=\"items-table\">\r\n<thead>\r\n<tr>\r\n    <th width=\"10%\">Sl No</th>\r\n    <th width=\"45%\">Test Name</th>\r\n    <th width=\"25%\">Actual Price (\u20b9)</th>\r\n    <th width=\"25%\">Price (\u20b9)</th>\r\n</tr>\r\n</thead>\r\n<tbody>\r\n{% for item in doc.ordered_items %}\r\n<tr>\r\n    <td>{{ loop.index }}</td>\r\n    <td>{{ item.name1 }}</td>\r\n    <td class=\"amount\">{{ item.actual_price }}</td>\r\n    <td class=\"amount\">{{ item.price }}</td>\r\n</tr>\r\n{% endfor %}\r\n</tbody>\r\n</table>\r\n\r\n<!-- TOTALS -->\r\n<div class=\"totals\">\r\n    <div class=\"totals-row\">\r\n        <span>Total Item Price</span>\r\n        <span>\u20b9 {{ doc.total_item_price }}</span>\r\n    </div>\r\n    <div class=\"totals-row\">\r\n        <span>Discount</span>\r\n        <span>\u20b9 {{ total_discount }}</span>\r\n    </div>\r\n     {% if doc.hard_copy_required %}\r\n    <div class=\"totals-row\">\r\n        <span>Hard Copy Charges</span>\r\n        <span>\u20b9 {{ hardcopy_charge }}</span>\r\n    </div>\r\n    {% endif %}\r\n    <div class=\"totals-row\">\r\n        <span>Total Amount</span>\r\n        <span>\u20b9 {{ doc.total_price }}</span>\r\n    </div>\r\n</div>\r\n\r\n<!-- FOOTER -->\r\n<div class=\"footer\">\r\n    <div style=\"text-align:right;\">\r\n        <b>Amount Paid:</b> \u20b9 {{ doc.total_price }}\r\n    </div>\r\n\r\n    <div style=\"text-align:center;margin-top:4px;\">\r\n        {% set amount_words = frappe.utils.money_in_words(doc.total_price) %}\r\n        <b>Amount in Words:</b> {{ amount_words }}\r\n    </div>\r\n\r\n    <div class=\"footer-bottom\">\r\n        <!--<div class=\"footer-left\">-->\r\n        <!--    <b>Phone:</b> 9611011266-->\r\n        <!--</div>-->\r\n        <!--<div class=\"footer-right\">-->\r\n        <!--    <b>Managing By</b><br>-->\r\n             <!--<img src=\"/files/bloodtestnearmelogo.png\" style=\"max-height:50px;\">-->\r\n        <!--     <img src=\"https://s3.ap-south-1.amazonaws.com/frappe-files-storage/triguna/2026/01/09/Print%20Format/CMGC9Q9A_Triguna_Health_Care-03_3000x3000.png\" style=\"max-height:250px;\">-->\r\n        <!--</div>-->\r\n        <div class=\"footer-right\">\r\n    <b>Managing By</b><br>\r\n    <img \r\n        src=\"/files/TrigunaHealthCare.png\"\r\n        style=\"max-height:250px; margin-top:-100px !important;\">\r\n</div>\r\n\r\n        \r\n    </div>\r\n</div>\r\n\r\n</div>",
